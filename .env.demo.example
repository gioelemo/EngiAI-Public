# Minimal environment for the EngiAI demo chatbot.
# Copy to .env and fill in real API keys before running:
#   docker compose -f docker-compose.demo.yml up -d --build

# --- Required API keys ---
TAVILY_API_KEY=tvly-replace-me
GOOGLE_API_KEY=replace-me
# OR
OPENAI_API_KEY=openai-replace-me

# --- Optional API keys ---
HF_TOKEN=hf_replace-me
WANDB_API_KEY=wandb-replace-me
USE_WANDB=False

# --- Model ---
LLM_MODEL=google_genai:gemini-3-flash-preview
# OR
#LLM_MODEL=openai:gpt-5.4-mini

# --- Database ---
# Used by both the postgres-demo container and the chatbot DATABASE_URL.
POSTGRES_PASSWORD=change_me_demo
