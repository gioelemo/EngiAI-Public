# API Keys Configuration
# Required API Keys
OPENAI_API_KEY=your-openai-api-key
GOOGLE_API_KEY=your-google-api-key
TAVILY_API_KEY=your-tavily-api-key

# Optional API Keys
ELEVENLABS_API_KEY=your-elevenlabs-api-key
HF_TOKEN=your-huggingface-token
LANGSMITH_API_KEY=your-langsmith-api-key
WANDB_API_KEY=your-wandb-api-key

# Models
# Text (required)
LLM_MODEL=openai:gpt-4.1
#LLM_MODEL=openai:gpt-4.1-mini
#LLM_MODEL=openai:gpt-4o
#LLM_MODEL=google_genai:gemini-2.5-flash
#LLM_MODEL=ollama:qwen3:4b

LLM_TEMPERATURE=0.7
#LLM_SEED=42

# Ollama context window size (default: 32768)
OLLAMA_NUM_CTX=32768

# Voice
VOICE_PROVIDER=elevenlabs  # Options: "elevenlabs" or "openai"

# ElevenLabs
ELEVENLABS_STT_MODEL=scribe_v2
ELEVENLABS_TTS_MODEL=eleven_multilingual_v2
ELEVENLABS_DEFAULT_VOICE=George
ELEVENLABS_VOICES=Rachel:21m00Tcm4TlvDq8ikWAM,Domi:AZnzlk1XvdvUeBnXmlld,Bella:EXAVITQu4vr4xnSDxMaL,Antoni:ErXwobaYiN019PkySvjV,Josh:TxGEqnHWrfWFTfGW9XjX,George:JBFqnCBsd6RMkjVDRZzb

# OpenAI Voice
OPENAI_STT_MODEL=whisper-1
OPENAI_TTS_MODEL=tts-1        # Options: "tts-1" or "tts-1-hd"
OPENAI_TTS_VOICE=alloy        # Options: alloy, echo, fable, onyx, nova, shimmer

# Database (PostgreSQL or SQLite)
# POSTGRES_PASSWORD is consumed by docker-compose.yml for the Postgres container
# and substituted into the default DATABASE_URL. Override DATABASE_URL directly
# if you point at an external database.
POSTGRES_PASSWORD=change_me
DATABASE_URL=postgresql://engiai_user:your_password@localhost:5432/engineer_assistant

# Paper Import
PAPERS_SOURCE_DIR=/Volumes/ShareName/Papers
PAPERS_STATE_FILE=data/local_import_state.json

# LangSmith Tracing
LANGCHAIN_TRACING=True
LANGCHAIN_PROJECT=engiai

# Weights & Biases
USE_WANDB=True
WANDB_ENTITY=YOUR_WANDB_ENTITY
WANDB_REPORT_URL=https://wandb.ai/YOUR_WANDB_ENTITY/engiopt/reports/your-report-id
WANDB_PERSONAL_PROJECT=YOUR_WANDB_ENTITY/engiopt
WANDB_OFFICIAL_PROJECT=engibench/engiopt

# Weave (LLM tracing and benchmarking)
USE_WEAVE=False
USE_WEAVE_CHATBOT=False
WEAVE_PROJECT=YOUR_WANDB_ENTITY/engiai-benchmarks

# Huggingface (used in SLURM job scripts)
HF_HOME=$HOME/.cache/huggingface/hub
HF_DATASETS_CACHE=$HOME/.cache/huggingface/datasets

# HPC / SLURM
HPC_HOST_ALIAS=your-cluster-alias

SLURM_TIME=00:45:00
SLURM_NTASKS=1
SLURM_CPUS_PER_TASK=4
SLURM_MEM_PER_CPU=7GB
SLURM_GPUS=rtx_4090:1
SLURM_STACK_MODULE=stack/2024-06
SLURM_GCC_MODULE=gcc/12.2.0
SLURM_PYTHON_MODULE=python_cuda/3.11.6
SLURM_CUDA_MODULE=cuda/12.8.0

# Prusa MCP (3D Printer)
SKIP_MCP=True
# Token file populated by `make prusa-login`
PRUSA_TOKEN_FILE=./data/prusa_tokens.json
