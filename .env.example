OPENAI_API_KEY=your-openai-api-key
TAVILY_API_KEY=your-tavily-api-key
GOOGLE_API_KEY=your-google-api-key
# MCP Server Configuration (for Prusa 3D Printer integration)
# Set to "true" to disable Prusa MCP server (recommended for basic Docker deployment)
SKIP_MCP=true

# External Prusa MCP Server URL (when SKIP_MCP=false)
# Use this to connect to an externally running MCP server
# Default: http://localhost:8765
PRUSA_MCP_URL=http://localhost:8765

# MCP Server Host and Port (for running standalone MCP server)
PRUSA_MCP_HOST=0.0.0.0
PRUSA_MCP_PORT=8765

# LLM Model Configuration
LLM_MODEL=openai:gpt-4.1

# LLM Temperature Configuration (0.0 to 2.0)
# Lower values (e.g., 0.2) make output more focused and deterministic
# Higher values (e.g., 1.5) make output more creative and varied
# Default: 0.7
LLM_TEMPERATURE=0.7

# LLM Seed Configuration (for reproducible outputs)
# Set to an integer (e.g., 42, 123) for deterministic behavior
# Leave empty or unset for non-deterministic behavior (default)
# Note: Determinism is not guaranteed across different model versions
# Default: None (non-deterministic)
# LLM_SEED=42

# Ollama Context Window Size
# Controls the context window size (num_ctx) for Ollama models
# Increase for models that support larger contexts or if hitting context limits
# Default: 32768 (32K tokens)
# Examples: 8192 (8K), 16384 (16K), 32768 (32K), 65536 (64K), 131072 (128K)
OLLAMA_NUM_CTX=32768


# MMORE RAG Service
# URL for MMORE multimodal RAG service
MMORE_RAG_URL=http://localhost:8000


# Database Configuration for Multi-Chat Feature
# For PostgreSQL: postgresql://username:password@host:port/database
# For SQLite (default): sqlite:///data/conversations.db
DATABASE_URL=postgresql://engiai_user:your_password@localhost:5432/engineer_assistant

# Paper Import Configuration
# PAPERS_SOURCE_DIR: Path to directory containing PDF papers on your HOST machine
# This folder will be mounted to /app/papers inside the Docker container
# Set this to your HOST machine's path where papers are stored
# Example macOS: /Volumes/ShareName/Papers
# Example Linux: /mnt/share/papers
# Example Windows: C:/Users/YourName/Documents/Papers
# Inside the container, papers are always accessed at /app/papers
PAPERS_SOURCE_DIR=/Volumes/XXX/YourPapersDirectory
# State file to track imported papers (relative to project root or absolute path)
PAPERS_STATE_FILE=data/local_import_state.json

# Host Service Configuration (for Docker GUI integration)
# Port for host service that allows Docker containers to open GUI applications on the host
# Default: 9999
HOST_SERVICE_PORT=9999

# LangSmith configuration
# Note: LANGCHAIN_* vars are read by config.py; LANGSMITH_API_KEY is read by the LangSmith SDK
LANGCHAIN_TRACING=true
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=your-langsmith-api-key
LANGCHAIN_PROJECT=engiai

# Wandb configuration
USE_WANDB=True
WANDB_API_KEY="your-wandb-api-key"
WANDB_ENTITY="YOUR_WANDB_ENTITY"
WANDB_REPORT_URL="https://wandb.ai/gioelemo-ethz/engiopt/reports/TEST--VmlldzoxNDc3ODQ2Mg"

# W&B projects for model downloads (tried in order when wandb_project=None)
WANDB_PERSONAL_PROJECT="gioelemo-ethz/engiopt"  # Your personal trained models
WANDB_OFFICIAL_PROJECT="engibench/engiopt"      # Official benchmark models

# Weave configuration (for LLM tracing and benchmarking)
# Separate project from engiopt to keep benchmark traces isolated
# USE_WEAVE: Enable tracing for evaluations and benchmarks
# USE_WEAVE_CHATBOT: Enable tracing for chatbot interactions (default: false)
USE_WEAVE=false
USE_WEAVE_CHATBOT=false
WEAVE_PROJECT="YOUR_WANDB_ENTITY/engiai-benchmarks"

# Huggingface configuration
# Local paths (for development on your machine)
HF_HOME="$HOME/.cache/huggingface/hub"
HF_DATASETS_CACHE="$HOME/.cache/huggingface/datasets"
HF_TOKEN="your_huggingface_token"  # Replace with your actual Huggingface token, create in Settings, Access Tokens, Read

# SLURM HPC Configuration for model training
SLURM_TIME=00:45:00
SLURM_NTASKS=1
SLURM_CPUS_PER_TASK=4
SLURM_MEM_PER_CPU=7GB
SLURM_GPUS=rtx_4090:1

SLURM_STACK_MODULE=stack/2024-06
SLURM_GCC_MODULE=gcc/12.2.0
SLURM_PYTHON_MODULE=python_cuda/3.11.6
SLURM_CUDA_MODULE=cuda/12.8.0

HPC_HOST_ALIAS="euler"
HPC_HOSTNAME="euler.ethz.ch"
HPC_USERNAME="your-username"

# Prusa Connect MCP Server Configuration
# prusa-mcp is installed as a pip dependency from GitHub and authenticates
# via OAuth2 (Authorization Code + PKCE) against account.prusa3d.com.
# Run `make prusa-login` once on the host to populate the token file below;
# the same file is mounted into the prusa-mcp-server container and reused.
# Host-side path — used by `make prusa-login`.
# The container overrides this to /app/data/prusa_tokens.json in docker-compose.yml.
PRUSA_TOKEN_FILE="./data/prusa_tokens.json"

# ElevenLabs Voice Configuration
# API key for ElevenLabs voice services (text-to-speech and speech-to-text)
ELEVENLABS_API_KEY=your-elevenlabs-api-key

# Voice model configuration (Speech-to-Text model)
ELEVENLABS_STT_MODEL=scribe_v2

# Voice model configuration (Text-to-Speech model)
ELEVENLABS_TTS_MODEL=eleven_multilingual_v2

# Available voice names and their IDs (comma-separated name:id pairs)
# Format: VoiceName:voice_id,AnotherVoice:voice_id
ELEVENLABS_VOICES=Rachel:21m00Tcm4TlvDq8ikWAM,Domi:AZnzlk1XvdvUeBnXmlld,Bella:EXAVITQu4vr4xnSDxMaL,Antoni:ErXwobaYiN019PkySvjV,Josh:TxGEqnHWrfWFTfGW9XjX,George:JBFqnCBsd6RMkjVDRZzb

# Default voice name (must match one of the names in ELEVENLABS_VOICES)
ELEVENLABS_DEFAULT_VOICE=George

# OpenAI Voice Configuration
# Voice provider selection: "elevenlabs" or "openai"
VOICE_PROVIDER=elevenlabs

# OpenAI TTS (Text-to-Speech) - Choose model quality
# tts-1: Standard quality, faster, cheaper
# tts-1-hd: High definition quality, slower, more expensive
OPENAI_TTS_MODEL=tts-1

# OpenAI TTS Voice Selection
# Available voices: alloy, echo, fable, onyx, nova, shimmer
OPENAI_TTS_VOICE=alloy

# OpenAI STT (Speech-to-Text) - Only one model available
OPENAI_STT_MODEL=whisper-1
