OPENAI_API_KEY=your-openai-api-key
TAVILY_API_KEY=your-tavily-api-key

# MCP Server Configuration (for Prusa 3D Printer integration)
# Set to "true" to disable Prusa MCP server (recommended for basic Docker deployment)
SKIP_MCP=true

# External Prusa MCP Server URL (when SKIP_MCP=false)
# Use this to connect to an externally running MCP server
# Default: http://localhost:8765
PRUSA_MCP_URL=http://localhost:8765

# MCP Server Host and Port (for running standalone MCP server)
PRUSA_MCP_HOST=0.0.0.0
PRUSA_MCP_PORT=8765

# MathPix API Credentials (required for PDF text extraction)
# Sign up at https://mathpix.com/ to get your API credentials
# You need BOTH the API ID and API KEY
MATHPIX_API_ID=your_mathpix_api_id
MATHPIX_API_KEY=your_mathpix_api_key

# LLM Model Configuration
# Works with any model - PDFs converted to text via MathPix
LLM_MODEL=openai:gpt-4.1

# LLM Temperature Configuration (0.0 to 2.0)
# Lower values (e.g., 0.2) make output more focused and deterministic
# Higher values (e.g., 1.5) make output more creative and varied
# Default: 0.7
LLM_TEMPERATURE=0.7

# Embeddings Model Configuration
# Used for vector store and RAG operations
EMBEDDINGS_MODEL=text-embedding-3-small


# Database Configuration for Multi-Chat Feature
# For PostgreSQL: postgresql://username:password@host:port/database
# For SQLite (default): sqlite:///data/conversations.db
DATABASE_URL=postgresql://engiai_user:your_password@localhost:5432/engineer_assistant

# Paper Import Configuration
# PAPERS_SOURCE_DIR: Path to directory containing PDF papers on your HOST machine
# This folder will be mounted to /app/papers inside the Docker container
# Set this to your HOST machine's path where papers are stored
# Example macOS: /Volumes/ShareName/Papers
# Example Linux: /mnt/share/papers
# Example Windows: C:/Users/YourName/Documents/Papers
# Inside the container, papers are always accessed at /app/papers
PAPERS_SOURCE_DIR=/Volumes/XXX/YourPapersDirectory
# State file to track imported papers (relative to project root or absolute path)
PAPERS_STATE_FILE=data/local_import_state.json
# ChromaDB collection name for imported papers
PAPERS_COLLECTION=engineer_docs

# CLI Tools configuration
# Path to PrusaSlicer executable (configure for your system)
# macOS: /Applications/Original Prusa Drivers/PrusaSlicer.app/Contents/MacOS/PrusaSlicer
# Windows: C:\Program Files\Prusa3D\PrusaSlicer\prusa-slicer-console.exe
# Linux: prusa-slicer (if in PATH)
PRUSA_SLICER_PATH=prusa-slicer

# Host Service Configuration (for Docker GUI integration)
# Port for host service that allows Docker containers to open GUI applications on the host
# Default: 9999
HOST_SERVICE_PORT=9999

# Langsmith configuration
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=your-langsmith-api-key
LANGSMITH_PROJECT=engineer-assistant

# Wandb configuration
USE_WANDB=True
WANDB_API_KEY="your-wandb-api-key"
WANDB_ENTITY="YOUR_WANDB_ENTITY"
WANDB_PROJECT="YOUR_WANDB_PROJECT WITH_YOUR_USERNAME"
WANDB_REPORT_URL="https://wandb.ai/gioelemo-ethz/engiopt/reports/TEST--VmlldzoxNDc3ODQ2Mg"

# W&B projects for model downloads (tried in order when wandb_project=None)
WANDB_PERSONAL_PROJECT="gioelemo-ethz/engiopt"  # Your personal trained models
WANDB_OFFICIAL_PROJECT="engibench/engiopt"      # Official benchmark models

# Huggingface configuration
# Local paths (for development on your machine)
HF_HOME="$HOME/.cache/huggingface/hub"
HF_DATASETS_CACHE="$HOME/.cache/huggingface/datasets"
# Remote paths (for HPC cluster SLURM jobs - will be expanded by shell)
HF_HOME_REMOTE="$$SCRATCH/models"
HF_DATASETS_CACHE_REMOTE="$$SCRATCH/datasets"
HF_TOKEN="your_huggingface_token"  # Replace with your actual Huggingface token, create in Settings, Access Tokens, Read

# SLURM HPC Configuration for model training
SLURM_TIME=00:45:00
SLURM_NTASKS=1
SLURM_CPUS_PER_TASK=4
SLURM_MEM_PER_CPU=7GB
SLURM_GPUS=rtx_4090:1
SLURM_EMAIL_USER=username@ethz.ch

SLURM_STACK_MODULE=stack/2024-06
SLURM_GCC_MODULE=gcc/12.2.0
SLURM_PYTHON_MODULE=python_cuda/3.11.6
SLURM_CUDA_MODULE=cuda/12.8.0

SLURM_VENV_PATH="~/venvs/engineer_assistant"
SLURM_PROJECT_PATH="$HOME/EngiOpt"

HPC_HOST_ALIAS="euler"

# Prusa Connect MCP Server Configuration
# Path to the prusa-mcp directory (default: ~/Desktop/prusa-mcp)
PRUSA_MCP_PATH="$HOME/Desktop/prusa-mcp"

# Local path to prusa-mcp folder for Docker volume mount (default: ~/Desktop/prusa-mcp)
PRUSA_MCP_LOCAL_PATH="$HOME/Desktop/prusa-mcp"

# Path to uv executable (default: ~/.local/bin/uv)
UV_PATH="$HOME/.local/bin/uv"

# Prusa Connect credentials (optional - can be provided at runtime via connect_login tool)
PRUSA_EMAIL="your-prusa-connect-email@example.com"
PRUSA_PASSWORD="your-prusa-connect-password"

# Prusa Connect API configuration (used by prusa-mcp server)
PRUSA_CONNECT_URL="https://connect.prusa3d.com"
PRUSA_CONNECT_STATE="connect_state.json"

# Browser automation settings for Prusa Connect login
HEADLESS=1  # Set to 0 to watch the browser during login
PW_TRACING=0  # Set to 1 to enable Playwright tracing for debugging
PW_NAV_TIMEOUT_MS=30000  # Navigation timeout in milliseconds
PW_SEL_TIMEOUT_MS=15000  # Selector timeout in milliseconds
