OPENAI_API_KEY=your-openai-api-key
TAVILY_API_KEY=your-tavily-api-key

LLM_MODEL=openai:gpt-4.1

# Agent configuration
ENABLE_CODE_EXECUTION_AGENT=false

LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=your-langsmith-api-key
LANGSMITH_PROJECT=engineer-assistant

# SLURM HPC Configuration for model training
SLURM_NODES=1
SLURM_NTASKS_PER_NODE=1
SLURM_CPUS_PER_TASK=4
SLURM_GPUS=1
SLURM_TIME=24:00:00
SLURM_MEM=32GB
SLURM_PARTITION=gpu
SLURM_PYTHON_MODULE=python/3.9
SLURM_CUDA_MODULE=cuda/11.3
SLURM_VENV_PATH=/path/to/venv
SLURM_PROJECT_PATH=/path/to/engiopt
